<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <View
        android:id="@+id/view_phrases_menu"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:background="@color/purple"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        />

    <ImageView
        android:id="@+id/image_all"
        android:src="@drawable/ic_all"
        app:tint="@color/white"
        android:layout_alignTop="@+id/view_phrases_menu"
        android:layout_alignBottom="@+id/view_phrases_menu"
        android:layout_marginStart="32dp"
        android:layout_width="45dp"
        android:layout_height="45dp"/>


    <ImageView
        android:id="@+id/image_happy"
        android:src="@drawable/ic_happy"
        app:tint="@color/white"
        android:layout_centerHorizontal="true"
        android:layout_alignTop="@+id/view_phrases_menu"
        android:layout_alignBottom="@+id/view_phrases_menu"
        android:layout_width="45dp"
        android:layout_height="45dp"/>

    <ImageView
        android:id="@+id/image_sunny"
        android:src="@drawable/ic_sunny"
        app:tint="@color/white"
        android:layout_alignParentEnd="true"
        android:layout_alignTop="@+id/view_phrases_menu"
        android:layout_alignBottom="@+id/view_phrases_menu"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginEnd="32dp"
        />

    <TextView
        android:id="@+id/textview_name"
        android:layout_below="@+id/view_phrases_menu"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:text="Olá, Kotlin!"
        android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/textview_phase"
        android:layout_centerInParent="true"
        android:layout_marginTop="32dp"
        android:text="Olá, Kotlin!"
        android:gravity="center"
        android:layout_margin="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <View
        android:layout_below="@+id/textview_phase"
        android:layout_width="135dp"
        android:layout_height="4dp"
        android:layout_centerHorizontal="true"
        android:background="@color/purple"
        android:layout_marginTop="8dp"
        android:elevation="5dp"
        />


    <Button
        android:id="@+id/button_new_phrase"
        android:text="Nova frase"
        android:backgroundTint="@color/purple"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
/>

</RelativeLayout>